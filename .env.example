# ─── Application ───────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=kheleo-core-backend
CORS_ORIGINS=http://localhost:3000

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://kheleo:kheleo_secret@localhost:5432/kheleo_core?schema=public

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional native TCP URL takes precedence over host/port credentials.
REDIS_URL=
REDIS_USERNAME=
REDIS_TLS=false
REDIS_DB=0

# ─── JWT ───────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy HS256 direct-token compatibility; never expose the signing secret.
SUPABASE_JWT_SECRET=
ADMIN_INVITE_CODE=

# ─── Identity Hashing ─────────────────────────────────
IDENTITY_PEPPER=change_this_to_a_random_64_char_hex_string
IDENTITY_SALT_VERSION=1

# ─── HMAC Device Signature ────────────────────────────
DRILL_HMAC_SECRET=change_this_to_a_random_64_char_hex_secret
# Production defaults to full/full-v2 signing. Legacy is for local compatibility.
DRILL_ALLOW_LEGACY_SIGNATURES=false

# ─── Telemetry Service Shared Secret ──────────────────
TELEMETRY_SERVICE_HMAC_SECRET=change_this_to_a_random_64_char_hex_secret
