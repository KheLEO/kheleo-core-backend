# ─── Application ───────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=kheleo-core-backend
CORS_ORIGINS=http://localhost:3001

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://kheleo:kheleo_secret@localhost:5432/kheleo_core?schema=public

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Identity Hashing ──────────────────────────────────
IDENTITY_PEPPER=change_this_to_a_random_64_char_hex_string
IDENTITY_SALT_VERSION=1

# ─── HMAC Secrets ──────────────────────────────────────
DRILL_HMAC_SECRET=change_this_to_a_random_64_char_hex_secret
TELEMETRY_SERVICE_HMAC_SECRET=change_this_to_a_random_64_char_hex_secret
