# ─── Application ───────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=kheleo-core-backend
CORS_ORIGINS=http://localhost:3001

# ─── Database ──────────────────────────────────────────
# Runtime pooled connection (Supavisor transaction mode :6543?pgbouncer=true&connection_limit=15&pool_timeout=10 in Supabase, or :5432 locally)
DATABASE_URL=postgresql://kheleo:kheleo_secret@localhost:5432/kheleo_core?schema=public
# Direct / session connection (:5432) used by Prisma migrations & scripts
DIRECT_URL=postgresql://kheleo:kheleo_secret@localhost:5432/kheleo_core?schema=public

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (Supply inline/base64 secrets OR local untracked paths) ─
# In Railway/container production, prefer JWT_PRIVATE_KEY + JWT_PUBLIC_KEY (PEM or base64-encoded RSA-3072)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENABLE_SWAGGER=false

# ─── Identity Hashing ──────────────────────────────────
IDENTITY_PEPPER=change_this_to_a_random_64_char_hex_string
IDENTITY_SALT_VERSION=1

# ─── Runtime Topology & Security Controls ────────────────
# Set ENABLE_EMBEDDED_WORKERS=false on HTTP API replicas when running a dedicated `pnpm start:worker` service.
ENABLE_EMBEDDED_WORKERS=true
# Enforces distributed Redis rate limits on auth, telemetry webhook, drill submit, and GTI recalculation.
RATE_LIMIT_ENABLED=true

# ─── HMAC Secrets ──────────────────────────────────────
DRILL_HMAC_SECRET=change_this_to_a_random_64_char_hex_secret
TELEMETRY_SERVICE_HMAC_SECRET=change_this_to_a_random_64_char_hex_secret
